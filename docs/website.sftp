# Upload docs/website/ to kq42.de (Strato). The SFTP login lands in the doc root (/kq42).
# Run from the repo root. Password auth: BatchMode must be off *before* -b, and pubkey auth off,
# because the 1Password agent offers 6 keys and Strato closes the connection after the 6th try:
#   sftp -oPubkeyAuthentication=no -oBatchMode=no -b docs/website.sftp stu800282259@527705.ssh.w1.strato.hosting
# A leading "-" lets a command fail without aborting (mkdir of an existing folder).
lcd docs/website
-mkdir assets
-mkdir impressum
-mkdir datenschutz
-mkdir plugins
-mkdir plugins/keymap-manager
put index.html index.html
put assets/site.css assets/site.css
put assets/lang.js assets/lang.js
put impressum/index.html impressum/index.html
put datenschutz/index.html datenschutz/index.html
put plugins/keymap-manager/index.html plugins/keymap-manager/index.html
ls -l
ls -l assets
ls -l plugins/keymap-manager
